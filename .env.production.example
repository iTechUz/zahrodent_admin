# Zahro Dental admin — production (server) muhiti
#
# Serverdagi fayl: /home/ubuntu/projects/zaxro_dent/zahrodent_admin/.env
# CI/CD konteynerni shu fayl bilan ishga tushiradi:
#   docker run -d --name zaxrodent_admin -p 8070:8070 --env-file <shu fayl> 10449/zaxrodent_admin:<sha>
#
# Konteyner ishga tushganda VITE_API_URL /env-config.js ga (window.__ENV__) yoziladi va
# build vaqtidagi qiymatdan ustun turadi — API manzilini o'zgartirish uchun faylni tahrirlab
# konteynerni qayta yaratish kifoya, image'ni qayta build qilish shart emas.
# Bu fayldagi qiymatlar brauzerga ochiq bo'ladi — maxfiy ma'lumot yozmang.

# MAJBURIY. Backend API ning to'liq URL manzili (https, oxirida '/' bo'lmasin).
# Backend CORS_ORIGINS da panel domeni ruxsat etilgan bo'lishi kerak.
VITE_API_URL=https://api.example.uz

# Ixtiyoriy (odatda kerak emas):
# window.__ENV__ ga chiqariladigan o'zgaruvchilar ro'yxati (bo'sh joy bilan ajratiladi).
# RUNTIME_ENV_VARS=VITE_API_URL
# env-config.js yoziladigan joy.
# ENV_CONFIG_PATH=/usr/share/nginx/html/env-config.js
