# Zahro Dental admin — production environment
#
# Docker (recommended): the image reads VITE_API_URL at *container start* and writes it to
# /env-config.js, so this file can be passed as-is:
#   docker run -p 8070:8070 --env-file .env <image>
# A plain `npm run build` (no Docker) bakes VITE_API_URL into the bundle instead.

# Backend API ning to'liq URL manzili (oxirida '/' bo'lmasin)
VITE_API_URL=https://api.zahro.iqroagency.uz
