# Zahro Dental admin — lokal ishlab chiqish (development)
#
#   cp .env.example .env && npm run dev
#
# .env git'ga qo'shilmaydi. Vite faqat VITE_ bilan boshlanadigan o'zgaruvchilarni
# bundle'ga qo'shadi — bu yerga maxfiy qiymat yozmang (hammasi brauzerda ko'rinadi).

# Backend API manzili (protokol bilan, oxirida '/' bo'lmasin).
# Lokal backend standart holatda 3000-portda ishlaydi.
VITE_API_URL=http://localhost:3000
